{
  "name": "reservasi-ruangan-pabwe2026-p6-sveltekit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "bun --bun vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "start": "bun ./build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:local": "bun --bun vite build",
    "build:netlify": "node scripts/configure-netlify.mjs && vite build"
  },
  "devDependencies": {
    "@sveltejs/adapter-bun": "^1.0.0",
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.0.3",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.3",

    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*.ts",
    "#features/*": "./src/features/*",
    "#helpers/*": "./src/helpers/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#lib/assets/*": "./src/lib/assets/*",
    "#features/auth/states/authStore": "./src/features/auth/states/authStore.ts"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "sweetalert2": "^11.26.25"
  }
}